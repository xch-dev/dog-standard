// An example inner puzzle layer that only lets holders with a valid credential hold tokens.
//
// This is a proof of concept for DOG extensions, and hasn't been audited.
//
// A credential is a BLS signature by the authority's key over a puzzle hash and an expiry time:
//
//     sha256(CREDENTIAL_PREFIX + puzzle_hash + expiry)
//
// The puzzle hash is the holder's inner puzzle hash (such as their standard puzzle hash), so the
// authority issues one credential per holder, offline, and the holder reuses it until it expires.
// The authority revokes a credential by not renewing it, which freezes the holder's tokens until it
// issues a new one.
//
// The layer wraps the holder's inner puzzle. To spend, the holder must show their own credential,
// and every coin the inner puzzle creates (other than change sent back to the same inner puzzle)
// must go to a puzzle hash with a credential. Every created coin is wrapped in this layer again, so
// the restriction applies to every future holder.
//
// Like the transfer fee layer, assets that use this layer must make sure that every coin is issued
// into it, since a coin of the same asset without the layer could join the ring and take the
// tokens.

// Separates credential signatures from anything else the authority's key signs.
const CREDENTIAL_PREFIX: Bytes = "dog credential";

fn main(
    mod_hash: Bytes32,
    authority_public_key: PublicKey,
    inner_puzzle: fn(...solution: Any) -> List<Condition>,
    my_expiry: Int,
    recipient_expiries: List<Int>,
    inner_solution: Any,
) -> List<Condition> {
    let layer = Layer {
        mod_hash,
        mod_hash_hash: tree_hash_atom(mod_hash),
        authority_public_key,
        authority_public_key_hash: tree_hash_atom(authority_public_key as Bytes),
    };

    let my_inner_puzzle_hash = tree_hash(inner_puzzle);

    credential(
        layer.authority_public_key,
        my_inner_puzzle_hash,
        my_expiry,
        wrap(layer, my_inner_puzzle_hash, recipient_expiries, inner_puzzle(...inner_solution)),
    )
}

struct Layer {
    mod_hash: Bytes32,
    mod_hash_hash: Bytes32,
    authority_public_key: PublicKey,
    authority_public_key_hash: Bytes32,
}

// Adds the conditions that check a credential for the puzzle hash, which expires at `expiry`.
fn credential(
    authority_public_key: PublicKey,
    puzzle_hash: Bytes32,
    expiry: Int,
    conditions: List<Condition>,
) -> List<Condition> {
    [
        AggSigUnsafe {
            public_key: authority_public_key,
            message: sha256(CREDENTIAL_PREFIX + puzzle_hash + expiry as Bytes),
        },
        AssertBeforeSecondsAbsolute { seconds: expiry },
        ...conditions,
    ]
}

// The puzzle hash of this layer around the given inner puzzle hash.
// The curried arguments are `(MOD_HASH AUTHORITY_PUBLIC_KEY INNER_PUZZLE)`.
fn layer_puzzle_hash(layer: Layer, inner_puzzle_hash: Bytes32) -> Bytes32 {
    curry_tree_hash(
        layer.mod_hash,
        [layer.mod_hash_hash, layer.authority_public_key_hash, inner_puzzle_hash],
    )
}

// Wraps the created coins in this layer, and checks the credential of each recipient. The expiry
// of each recipient's credential is taken from `expiries`, in order.
fn wrap(
    layer: Layer,
    my_inner_puzzle_hash: Bytes32,
    expiries: List<Int>,
    conditions: List<Condition>,
) -> List<Condition> {
    if conditions is nil {
        return nil;
    }

    inline let (condition, rest) = conditions;

    if !(condition is CreateCoin) {
        return [condition, ...wrap(layer, my_inner_puzzle_hash, expiries, rest)];
    }

    let created = CreateCoin {
        puzzle_hash: layer_puzzle_hash(layer, condition.puzzle_hash),
        amount: condition.amount,
        memos: condition.memos,
    };

    // The holder's own credential has already been checked.
    if condition.puzzle_hash == my_inner_puzzle_hash {
        return [created, ...wrap(layer, my_inner_puzzle_hash, expiries, rest)];
    }

    // Each recipient needs the expiry of its credential.
    assert expiries is (Int, List<Int>);

    inline let (expiry, other_expiries) = expiries;

    [
        created,
        ...credential(
            layer.authority_public_key,
            condition.puzzle_hash,
            expiry,
            wrap(layer, my_inner_puzzle_hash, other_expiries, rest),
        ),
    ]
}
