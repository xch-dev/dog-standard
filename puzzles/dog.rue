// The DOG coin puzzle.
//
// A DOG coin is always worth 0 mojos, and its token amount is curried into its puzzle. Spending it
// creates an execution coin (`dog_exec.rue`) worth the token amount in mojos, which runs the inner
// puzzle. The DOG coin sends the execution coin a message, so both have to be spent in the same
// block, and the execution coin can check that its parent is a DOG coin.
//
// Tokens are valid if either:
// - The parent is an execution coin of the same asset, which is proven with a lineage proof.
// - The TAIL authorizes the supply change, which is all of the tokens if there's no lineage proof.
//
// Running the TAIL can also issue or melt tokens, by changing the amount of the execution coin.

import shared::{Asset, DOG_TO_EXEC_MODE, asset_args_hash, exec_puzzle_hash};

// Proof that the parent of this DOG coin is an execution coin of the same asset.
struct LineageProof {
    parent_parent_coin_info: Bytes32,
    parent_inner_puzzle_hash: Bytes32,
    parent_amount: Int,
}

// The TAIL decides whether the supply of the asset can change.
//
// It's called with the change in supply, which is positive when issuing and negative when melting,
// along with its solution. It returns conditions that must be met for the change to be allowed.
//
// The supply change is the amount of the execution coin minus the amount that's proven with a
// lineage proof (or zero, if there isn't one).
type Tail = fn(supply_change: Int, ...solution: Any) -> List<Condition>;

// A reveal of the TAIL, to change the supply or to spend a coin without a lineage proof.
struct TailSpend {
    // The TAIL puzzle.
    tail: Tail,

    // The tree hash of the asset's metadata.
    // The asset id is the tree hash of the pair `(TAIL . METADATA)`.
    metadata_hash: Bytes32,

    // The amount to add to the curried amount to get the amount of the execution coin.
    delta: Int,

    // The solution passed to the TAIL.
    ...solution: Any,
}

fn main(
    inner_puzzle_hash: Bytes32,
    amount: Int,
    asset: Asset,
    my_coin_id: Bytes32,
    lineage_proof: LineageProof | nil,
    tail_spend: TailSpend | nil,
) -> List<Condition> {
    let asset_args_hash = asset_args_hash(asset);

    // Without a lineage proof, none of the tokens are proven to exist yet.
    let proven_amount = if lineage_proof is nil {
        0
    } else {
        amount
    };

    let (new_amount, tail_conditions) = if tail_spend is nil {
        // The tokens must already exist if the TAIL isn't run.
        assert !(lineage_proof is nil);

        (amount, nil)
    } else {
        // Make sure that the revealed TAIL and metadata belong to this asset.
        assert tree_hash_pair(
            tree_hash(tail_spend.tail),
            tail_spend.metadata_hash,
        ) == asset.asset_id;

        let new_amount = amount + tail_spend.delta;

        (new_amount, tail_spend.tail(new_amount - proven_amount, ...tail_spend.solution))
    };

    let child_puzzle_hash = exec_puzzle_hash(
        asset_args_hash,
        asset.exec_mod_hash,
        inner_puzzle_hash,
    );

    // If the amount is negative or too large, `coinid` raises.
    let exec_coin_id = coinid(my_coin_id, child_puzzle_hash, new_amount);

    let conditions = [
        AssertMyCoinId { coin_id: my_coin_id },
        CreateCoin { puzzle_hash: child_puzzle_hash, amount: new_amount },
        SendMessage {
            mode: DOG_TO_EXEC_MODE,
            message: new_amount as Bytes,
            receiver: [exec_coin_id],
        },
        ...tail_conditions,
    ];

    if lineage_proof is nil {
        return conditions;
    }

    let parent_coin_id = coinid(
        lineage_proof.parent_parent_coin_info,
        exec_puzzle_hash(
            asset_args_hash,
            asset.exec_mod_hash,
            lineage_proof.parent_inner_puzzle_hash,
        ),
        lineage_proof.parent_amount,
    );

    [AssertMyParentId { parent_id: parent_coin_id }, ...conditions]
}
